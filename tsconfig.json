{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "paths": {
      "macalicious/lib/*": ["./src/lib/*"],
      "macalicious/*": ["./src/components/*/index.ts"]
    }
  },
  "include": ["src", "docs", "demos", "visual", "test", "*.ts"],
  "exclude": ["node_modules", "dist", "docs/dist", "visual/output"]
}
