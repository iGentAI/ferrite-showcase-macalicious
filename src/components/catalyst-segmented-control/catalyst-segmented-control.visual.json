    {
      "name": "states-light",
      "description": "What no screenshot shows, Aqua: three segments of 80 pt, the first selected.",
      "example": "visual-states",
      "appearance": "light",
      "expect": {
        "size": {
          "width": 260,
          "height": 45
        },
        "pixels": [
          {
            "x": 50,
            "y": 22,
            "color": "#ffffff",
            "note": "the pill in the first segment (spec: Colours, pill, measured)"
          },
          {
            "x": 130,
            "y": 22,
            "color": "#e8e7e6",
            "tolerance": 2,
            "note": "the track in the second segment: grey at 12% over the sidebar (spec: track, as a recipe)"
          },
          {
            "x": 5,
            "y": 22,
            "color": "#f8f7f5",
            "note": "the sidebar beside the track: the shadow does not leave the track"
          }
        ]
      }
    },
    {
      "name": "states-dark",
      "description": "What no screenshot shows, Dark Aqua: three segments of 80 pt, the first selected.",
      "example": "visual-states",
      "appearance": "dark",
      "expect": {
        "size": {
          "width": 260,
          "height": 45
        },
        "pixels": [
          {
            "x": 50,
            "y": 22,
            "color": "#6b6b72",
            "note": "the pill in the first segment (spec: Colours, pill, measured)"
