      "expect": {
        "size": {
          "width": 260,
          "height": 45
        },
        "pixels": [
          {
            "x": 130,
            "y": 22,
            "color": "#ffffff",
            "note": "the pill, now in the second segment"
          },
          {
            "x": 50,
            "y": 22,
            "color": "#e8e7e6",
            "tolerance": 2,
            "note": "the track, bare in the first segment"
          }
        ]
      }
    },
