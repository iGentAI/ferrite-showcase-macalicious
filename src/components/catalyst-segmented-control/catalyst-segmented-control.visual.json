          "x": 50,
          "y": 13,
          "width": 38,
          "height": 13
        },
        {
          "x": 171,
          "y": 13,
          "width": 42,
          "height": 13
        }
      ],
      "threshold": 0.05,
      "budget": {
        "1x": 0.0034,
        "2x": 0.0011
      },
      "deltaBudget": {
        "1x": 1.2,
        "2x": 0.89
      },
      "reference": {
        "file": "10-15-Catalina-Light-Find-My.png",
        "crop": {
          "x": 114,
          "y": 136,
          "width": 520,
          "height": 80
        }
      }
    },
