    {
      "name": "toggle-click",
      "description": "An accessory tile that is off, clicked: it becomes the opaque white tile. The screenshots show both states but not the change.",
      "example": "visual-accessory-off",
      "appearance": "light",
      "actions": [
        {
          "click": ".mac-homekit-tile"
        }
      ],
      "expect": {
        "size": {
          "width": 102,
          "height": 102
        },
        "pixels": [
          {
            "x": 80,
            "y": 20,
            "color": "#ffffff",
            "note": "active fill (spec: Colours, on tile fill, measured)"
          },
          {
            "x": 51,
            "y": 1,
            "color": "#ffffff",
            "note": "the fill reaches the tile's top edge: no border (spec: Geometry, border none, measured)"
          }
        ]
      }
    },
    {
      "name": "toggle-keyboard",
      "description": "The same from the keyboard, Dark Aqua: Tab focuses the tile and Space turns it on; an active tile is white in Dark Aqua too.",
      "example": "visual-accessory-off",
      "appearance": "dark",
      "actions": [
        {
          "tab": 1
        },
        {
          "key": "Space"
        }
      ],
      "expect": {
        "size": {
          "width": 102,
          "height": 102
        },
        "pixels": [
          {
            "x": 80,
            "y": 20,
            "color": "#ffffff",
            "note": "active fill, the same in both appearances (spec: Colours, on tile fill, measured)"
          }
        ]
      }
    },
