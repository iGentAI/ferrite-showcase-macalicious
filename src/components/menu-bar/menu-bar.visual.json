    {
      "name": "hover-switch-light",
      "description": "Real input: with the Finder menu open, the pointer moves to the File title, which opens its menu and takes the highlight. Captures the File title.",
      "example": "visual-finder-bar",
      "appearance": "light",
      "selector": "[data-testid=file]",
      "actions": [
        {
          "click": "[data-testid=finder]"
        },
        {
          "hover": "[data-testid=file]"
        }
      ],
      "expect": {
        "pixels": [
          {
            "x": 3,
            "y": 3,
            "color": "#2a7cef",
            "tolerance": 3,
            "note": "highlight of the open title: the blue menu bar highlight over the bar material (menu-bar.md, Open-title highlight, measured #2a7cef on the Apple title)"
          }
        ]
      }
    },
    {
      "name": "hover-leaves-light",
      "description": "The same input, capturing the Finder title: its menu closed when the pointer moved on, so the cell shows the bar again.",
      "example": "visual-finder-bar",
      "appearance": "light",
      "selector": "[data-testid=finder]",
